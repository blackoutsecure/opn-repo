# Local firewall configurations and backups can contain credentials.
/conf/backup/
config.xml
config.xml.*
config-*.xml
config-*.xml.*

# Local environment files, private keys, and certificate bundles.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
ca.pem.*

# Local LibreSpeed settings, measurement history, and browser download copies.
librespeed-servers.json
librespeed-servers.json.*
!librespeed-servers.json.example
speedtest.csv*
speedtest.jsonl*
speedtest ([0-9]*).csv*
speedtest ([0-9]*).jsonl*

# Speedtest package staging and release artifacts.
/net-mgmt/speedtest-community/work/
os-speedtest-community-*.pkg
os-speedtest-community-*.pkg.*

# Generated Python bytecode and macOS filesystem metadata.
__pycache__/
*.pyc
.DS_Store
._*
__MACOSX/
