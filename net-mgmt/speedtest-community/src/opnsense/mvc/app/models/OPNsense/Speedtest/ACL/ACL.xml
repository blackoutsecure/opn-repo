<acl>
    <page-reporting-speedtest>
        <name>Reporting: Speedtest: View results</name>
        <patterns>
            <pattern>ui/speedtest/*</pattern>
            <pattern>api/speedtest/service/version</pattern>
            <pattern>api/speedtest/service/defaults</pattern>
            <pattern>api/speedtest/service/serverlist</pattern>
            <pattern>api/speedtest/service/showstat</pattern>
            <pattern>api/speedtest/service/showrecent</pattern>
            <pattern>api/speedtest/service/showlog</pattern>
            <pattern>api/speedtest/service/stat</pattern>
            <pattern>api/speedtest/service/status</pattern>
            <pattern>api/speedtest/service/detectionstatus</pattern>
            <pattern>api/speedtest/service/history</pattern>
            <pattern>api/speedtest/download/csv</pattern>
            <pattern>api/speedtest/download/json</pattern>
        </patterns>
    </page-reporting-speedtest>
    <page-reporting-speedtest-run>
        <name>Reporting: Speedtest: Run tests</name>
        <patterns><pattern>api/speedtest/service/run/*</pattern><pattern>api/speedtest/service/run</pattern><pattern>api/speedtest/service/start</pattern><pattern>api/speedtest/service/start/*</pattern><pattern>api/speedtest/service/detect</pattern></patterns>
    </page-reporting-speedtest-run>
    <page-reporting-speedtest-settings>
        <name>Reporting: Speedtest: Configure settings</name>
        <patterns><pattern>api/speedtest/settings/get</pattern><pattern>api/speedtest/settings/set</pattern><pattern>api/speedtest/settings/catalog</pattern></patterns>
    </page-reporting-speedtest-settings>
    <page-reporting-speedtest-schedule>
        <name>Reporting: Speedtest: Manage schedule</name>
        <patterns><pattern>api/speedtest/schedule/get</pattern><pattern>api/speedtest/schedule/set</pattern><pattern>api/speedtest/schedule/apply</pattern></patterns>
    </page-reporting-speedtest-schedule>
    <page-reporting-speedtest-clear>
        <name>Reporting: Speedtest: Clear history</name>
        <patterns><pattern>api/speedtest/service/deletelog</pattern><pattern>api/speedtest/service/deletelog/*</pattern></patterns>
    </page-reporting-speedtest-clear>
</acl>
